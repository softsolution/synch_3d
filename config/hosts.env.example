# Справочник вашей фермы (8 хостов). Не используется скриптом напрямую —
# на каждом хосте в sync-caps.env указывается один MASTER_IP.
#
# HOST_NAME          IP              ROLE
# ----------------   -------------   ---------------------------
# printer-master     192.168.1.10    головной (склад caps + печать)
# printer-02         192.168.1.11    slave
# printer-03         192.168.1.12    slave
# printer-04         192.168.1.13    slave
# printer-05         192.168.1.14    slave
# printer-06         192.168.1.15    slave
# printer-07         192.168.1.16    slave
# printer-08         192.168.1.17    slave
#
# Замените IP на ваши статические адреса Armbian.

MASTER_IP=192.168.1.10
