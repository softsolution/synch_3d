# Конфигурация push caps с этого Windows-ПК на головной хост.
# Запуск: bash scripts/sync-caps-from-windows.sh

# --- Головной хост ---
MASTER_IP=192.168.1.109
MASTER_USER=klipper
MASTER_CAPS_PATH=gcodes/caps

# --- Локальная папка caps на Windows (ОБЯЗАТЕЛЬНО укажите свой путь) ---
LOCAL_CAPS_PATH=D:/YandexDisk/3D/Models/22_Заглушки/gcodes

# --- Rsync ---
RSYNC_DELETE=1
RSYNC_CHECKSUM=0
RSYNC_TIMEOUT=600

# --- Metascan на мастере после загрузки ---
REMOTE_METASCAN=1
MASTER_SYNC_SCRIPT=/home/klipper/bin/sync-caps.sh
MASTER_SYNC_CONFIG=/home/klipper/fbg51_data/config/sync-caps.env
FORCE_MASTER_METASCAN=1

# --- Лог ---
LOG_FILE=C:/OSPanel/home/sync/logs/sync-caps-from-windows.log
