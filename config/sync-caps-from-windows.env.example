# Конфигурация синхронизации caps с Windows-ПК на головной хост (push).
# Копируйте рядом с этим файлом как sync-caps-from-windows.env и отредактируйте.
#
# Запуск (Git Bash или WSL из каталога репозитория):
#   bash scripts/sync-caps-from-windows.sh
# или с явным путём к конфигу:
#   SYNC_CAPS_FROM_WINDOWS_CONFIG=C:/OSPanel/home/sync/config/sync-caps-from-windows.env \
#     bash scripts/sync-caps-from-windows.sh
#
# Требования на Windows: rsync и ssh в PATH (Git Bash + cwRsync, или WSL).

# --- Головной хост (приёмник файлов) ---
MASTER_IP=192.168.1.109
MASTER_USER=klipper
# Путь на мастере относительно домашнего каталога MASTER_USER (без ведущего /)
MASTER_CAPS_PATH=gcodes/caps

# --- Локальная папка caps на Windows ---
# Git Bash: C:/Users/ИМЯ/caps  или  /c/Users/ИМЯ/caps
# WSL:     /mnt/c/Users/ИМЯ/caps
LOCAL_CAPS_PATH=C:/Users/ИМЯ/caps

# --- SSH (опционально) ---
# Пусто = стандартный ключ (~/.ssh/id_ed25519 или id_rsa)
# SSH_IDENTITY_FILE=C:/Users/ИМЯ/.ssh/id_ed25519

# --- Способ копирования ---
# auto = rsync если установлен, иначе scp (OpenSSH в Git Bash, без установки rsync)
# SYNC_BACKEND=auto
# SYNC_BACKEND=scp
# RSYNC_BIN=C:/Program Files/cwRsync/bin/rsync.exe

# --- Rsync (Windows → мастер) ---
# 1 = зеркало: на мастере удаляются файлы, которых нет в локальной caps/
RSYNC_DELETE=1
# 1 = сравнение по checksum (медленнее)
RSYNC_CHECKSUM=0
RSYNC_TIMEOUT=600

# --- Metascan на мастере после загрузки ---
# Мастер тоже печатает: после push обновить метаданные Moonraker без rsync.
REMOTE_METASCAN=1
# Скрипт и конфиг sync-caps на мастере (как после install-on-host.sh)
MASTER_SYNC_SCRIPT=/home/klipper/bin/sync-caps.sh
MASTER_SYNC_CONFIG=/home/klipper/printer_data/config/sync-caps.env
# 1 = ssh … FORCE_MASTER_MODE=1 sync-caps.sh (только metascan на мастере)
FORCE_MASTER_METASCAN=1

# --- Лог на Windows ---
LOG_FILE=C:/OSPanel/home/sync/logs/sync-caps-from-windows.log
