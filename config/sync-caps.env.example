# Копируется install-on-host.sh в каталог config вашего Klipper.
# Имя папки (*_data) на хостах разное — путь задаётся при установке:
#   SYNC_CONFIG_DIR=/home/klipper/fbg51_data/config ./install-on-host.sh
# Права: chmod 600 …/config/sync-caps.env

# --- Головной хост (источник файлов) ---
MASTER_IP=192.168.1.10
MASTER_USER=pi
# Путь на мастере относительно домашнего каталога MASTER_USER (без ведущего /)
MASTER_CAPS_PATH=gcodes/caps

# --- Локальные пути на этом хосте ---
# Каталог gcodes (куда указывает симлинк printer_*_data/gcodes)
GCODES_ROOT=/home/pi/printer_data/gcodes
# Синхронизируем только эту подпапку (не трогаем файлы выше)
SYNC_SUBDIR=caps

# --- Moonraker (на хосте с двумя принтерами — оба порта) ---
MOONRAKER_HOST=127.0.0.1
MOONRAKER_PORTS="7125 7126"

# --- Поведение ---
# 1 = не запускать sync, пока хотя бы один принтер печатает
BLOCK_WHILE_PRINTING=1
# 1 = удалять на slave файлы/папки, которых нет на мастере (зеркало caps/)
RSYNC_DELETE=1
# 1 = сравнивать по checksum (медленнее, но надёжнее при одинаковом размере и разном содержимом)
RSYNC_CHECKSUM=0
# Таймаут rsync в секундах
RSYNC_TIMEOUT=600

# --- Этот хост является мастером? ---
# Оставьте 0 на всех; скрипт сам определит мастер по MASTER_IP и локальному IP.
# Принудительно: 1 = только обновить метаданные Moonraker (без rsync)
FORCE_MASTER_MODE=0

# --- Лог ---
LOG_FILE=/home/pi/printer_data/logs/sync-caps.log
